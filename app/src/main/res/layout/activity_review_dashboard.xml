<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/afc_black">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/afc_red"
        app:title="Review Dashboard"
        app:titleTextColor="@color/afc_white"
        app:navigationIcon="@drawable/ic_arrow_back_white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Product Insights Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Insights"
                android:textColor="@color/afc_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/afc_dark_grey"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvHighestRated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Highest Rated: Loading..."
                        android:textColor="@color/afc_white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvLowestRated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lowest Rated: Loading..."
                        android:textColor="@color/afc_white"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvMostReviewed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Most Reviewed: Loading..."
                        android:textColor="@color/afc_white"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search and Filter Section -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search reviews by user or text"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="@color/afc_red"
                app:hintTextColor="@color/afc_red"
                android:textColorHint="@color/afc_grey">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearchReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/afc_white" />
            </com.google.android.material.textfield.TextInputLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:checked="true"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        app:chipBackgroundColor="@color/afc_dark_grey"
                        android:textColor="@color/afc_white" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip5Star"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 Stars"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        app:chipBackgroundColor="@color/afc_dark_grey"
                        android:textColor="@color/afc_white" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip4Star"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 Stars"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        app:chipBackgroundColor="@color/afc_dark_grey"
                        android:textColor="@color/afc_white" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip1Star"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 Star"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        app:chipBackgroundColor="@color/afc_dark_grey"
                        android:textColor="@color/afc_white" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAllReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
